{
  "name": "@aperturesyndicate/grain",
  "version": "1.2.1",
  "description": "GRAIN — the APERTURESyndicate code standard: vocabularies as data, an ESLint plugin and a checker for TypeScript, Rust, SQL, Kotlin, Swift and SYNX",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APERTURESyndicate/grain.git"
  },
  "homepage": "https://docs.aperturesyndicate.com/en/grain/overview",
  "bugs": "https://github.com/APERTURESyndicate/grain/issues",
  "keywords": ["lint", "eslint-plugin", "code-standard", "naming", "bun", "synx"],
  "engines": {
    "bun": ">=1.1"
  },
  "bin": {
    "grain": "./bin/grain.entry.ts"
  },
  "exports": {
    ".": "./src/public.js",
    "./grain.synx": "./grain.synx"
  },
  "files": [
    "bin",
    "src",
    "grain.synx",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "grain": "bun bin/grain.entry.ts",
    "test": "bun test",
    "docs": "bun bin/grain-docs.entry.ts",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0"
  }
}
